# Copy to .env and edit. All settings are optional; defaults shown.

# Where CSVs/cache and charts go (relative paths are from the project root)
# MV_DATA_DIR=data
# MV_FIGURES_DIR=figures

# Target districts as NCES_ID:ShortName pairs (default: Kannapolis, Cabarrus, Rowan-Salisbury)
# MV_DISTRICTS=3702430:Kannapolis,3700530:Cabarrus,3704050:Rowan-Salisbury

# HTTP etiquette
# MV_REQUEST_PAUSE_SEC=0.5
# MV_USER_AGENT=Mozilla/5.0 (compatible; mckinney-vento-analysis/0.1)
